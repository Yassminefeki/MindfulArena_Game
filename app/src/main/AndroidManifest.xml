<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.xo">

    <application
        android:allowBackup="true"
        android:icon="@drawable/logo"
        android:roundIcon="@drawable/logo"
        android:label="Mindful Arena"
        android:theme="@style/Theme.MindfulArena">

        <activity android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".activities.SplashActivity" />
        <activity android:name=".activities.HomeActivity" />
        <activity android:name=".activities.GameActivity" />
        <activity android:name=".activities.ResultActivity" />
        <activity android:name=".activities.StatisticsActivity" />
        <activity android:name=".activities.SettingsActivity" />
        <activity android:name=".activities.TournamentActivity" />
        <activity android:name=".activities.OnlineGameActivity" />

    </application>
</manifest>